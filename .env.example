# Copie este arquivo para .env e preencha.

# Obrigatória
ANTHROPIC_API_KEY=

# Opcional: sem ela, a busca usa a pesquisa web do Claude
GOOGLE_MAPS_API_KEY=

# Opcional: sem ela, áudios chegam como "[áudio não transcrito]"
OPENAI_API_KEY=

# Opcional: sem ele, o pagamento Pix é simulado
MP_ACCESS_TOKEN=
# E-mail do pagador exigido pelo Mercado Pago (ou preencha em Configurações)
MP_PAYER_EMAIL=

PORT=3333

# (V1) celular de teste que entrava no topo da busca. Na V2, cadastre o teste no /admin.
DEV_TEST_PROVIDER_PHONE=

# Logs (opcional)
# LOG_LEVEL=info
# WA_LOG_LEVEL=warn

# ---------- V2: WhatsApp oficial (número do Desenrola via Twilio) ----------
# Sem estas, o canal roda em "stub": nada sai, só aparece no log.
# Em dev, simule o prestador respondendo com POST /api/dev/whatsapp/inbound.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Remetente WhatsApp aprovado (no sandbox da Twilio: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=
# URL pública do webhook, exatamente como cadastrada na Twilio (a assinatura é conferida com ela)
WHATSAPP_WEBHOOK_URL=
# SIDs dos templates aprovados (saem de: npm run wa:templates -- submit)
WA_TPL_CODIGO_VERIFICACAO=
WA_TPL_BOAS_VINDAS=
WA_TPL_PEDIDO_NOVO=
WA_TPL_QUAL_PEDIDO=
WA_TPL_PRESTADOR_LEMBRETE=
WA_TPL_PERGUNTA_DO_CLIENTE=
WA_TPL_ORCAMENTO_APROVADO=
WA_TPL_PEDIDO_ENCERRADO=
WA_TPL_CLIENTE_ORCAMENTO_CHEGOU=
WA_TPL_CLIENTE_PERGUNTA_PRESTADOR=
WA_TPL_CLIENTE_AVALIACAO=

# Senha do /admin. Em dev, sem ela qualquer senha entra; em produção é obrigatória.
ADMIN_PASSWORD=
# Opcional: esconde o site inteiro (Basic) antes do lançamento
SITE_PASSWORD=
# Endereço público do site (vai nos links dos avisos pro cliente)
PUBLIC_URL=http://localhost:5173
# Pasta do banco (no Render: /var/data, o disco persistente)
# DATA_DIR=
